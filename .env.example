# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.
# Docs on env in Next.js: https://nextjs.org/docs/app/guides/environment-variables
#
# LEARNING NOTE (Lesson 06): variables WITHOUT the NEXT_PUBLIC_ prefix are
# server-only and read at runtime. Anything NEXT_PUBLIC_* is inlined into the
# client bundle at BUILD time — never put a secret there.

# --- Database (Neon Postgres) ---------------------------------------------
# Create a free project at https://neon.tech and copy the connection string.
DATABASE_URL="postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) ------------------------------------------------
# Generate with: npx auth secret   (writes AUTH_SECRET automatically)
# Used to encrypt the session JWT / tokens. https://authjs.dev/getting-started/installation
AUTH_SECRET=""

# OAuth provider example (optional). https://authjs.dev/getting-started/authentication/oauth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Production only (Lesson 06) ------------------------------------------
# Pin this across all instances so Server Actions decrypt everywhere.
# https://nextjs.org/docs/app/guides/self-hosting#server-functions-encryption-key
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
